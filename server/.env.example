PORT=5050
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────
# Local (docker run -d --name aicp-mongo -p 27017:27017 mongo:7) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/aicp

# ─── JWT ─────────────────────────────────────────────────────────
# Use a long, random secret in production
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Frontend origin(s) allowed by CORS, comma-separated ─────────
FRONTEND_URL=http://localhost:5173,http://localhost:5199

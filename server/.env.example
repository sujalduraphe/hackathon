PORT=5050
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────
# Local (docker run -d --name aicp-mongo -p 27017:27017 mongo:7) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/aicp

# ─── JWT ─────────────────────────────────────────────────────────
# Use a long, random secret in production
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Frontend origin(s) allowed by CORS, comma-separated ─────────
FRONTEND_URL=http://localhost:5173,http://localhost:5199

# ─── Social sign-in (optional; buttons stay hidden until set) ─────
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorised JavaScript origins: http://localhost:5173 (and your deployed site)
GOOGLE_CLIENT_ID=
# LinkedIn: linkedin.com/developers → Create app → Auth tab; add product "Sign In with LinkedIn using OpenID Connect"
#   Authorised redirect URL: http://localhost:5050/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5050/api/auth/linkedin/callback
